   <style>
        .cw-progress-shell {
            margin: 0;
            padding: 8px 12px 10px;
            background: transparent;
            font-family: "Helvetica Neue", Arial, sans-serif;
            color: #222;
            margin: 0 auto;
        }

        .cw-progress-card {
            background: transparent;
        }

        .cw-progress-text {
            font-size: 0.95rem;
            color: #333;
            text-align: center;
            margin: 0 0 5px;
            line-height: 1.2;
        }

        .cw-progress-text strong {
            color: #000000;
        }

        .cw-progress-rail-wrap {
            position: relative;
            padding: 0 2px;
        }

        .cw-progress-rail {
            position: absolute;
            top: 15px;
            left: calc(16px + 22px);
            right: calc(16px + 22px);
            height: 5px;
            background: #e0e0e0;
            border-radius: 10px;
            overflow: hidden;
            z-index: 0;
        }

        .cw-progress-rail-fill {
            height: 100%;
            width: 0%;
            background: linear-gradient(to right, #000000, #020101);
            border-radius: 10px;
            transition: width 0.6s cubic-bezier(.4, 0, .2, 1);
        }

        .cw-progress-points {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            position: relative;
            z-index: 1;
        }

        .cw-progress-points.cw-progress-points--single {
            justify-content: flex-end;
            width: 170px;
            margin-left: auto;
        }

        .cw-progress-point {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
            flex: 1;
        }

        .cw-progress-badge {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: #f0f0f0;
            border: 2.5px solid #d0d0d0;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background 0.4s, border-color 0.4s, box-shadow 0.4s;
            position: relative;
        }

        .cw-progress-badge svg {
            width: 20px;
            height: 20px;
            color: #999;
            transition: color 0.4s;
        }

        .cw-progress-point.cw-progress-point--active .cw-progress-badge {
            background: #fff;
            border-color: #000000;
            /* box-shadow: 0 0 0 4px rgba(230, 57, 70, 0.12); */
        }

        .cw-progress-point.cw-progress-point--active .cw-progress-badge svg {
            color: #000000;
        }

        .cw-progress-point.cw-progress-point--done .cw-progress-badge {
            background: linear-gradient(135deg, #000000, #000000);
            border-color: #000000;
            box-shadow: 0 4px 14px rgb(0 0 0 / 30%);
        }

        .cw-progress-point.cw-progress-point--done .cw-progress-badge svg {
            color: #fff;
            display: none;
        }

        .cw-progress-point.cw-progress-point--done .cw-progress-badge::after {
            content: "\2713";
            position: absolute;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            color: #fff;
            font-weight: 700;
        }

        .cw-progress-caption {
            font-size: 0.78rem;
            font-weight: 600;
            color: #999;
            text-align: center;
            line-height: 1.4;
            transition: color 0.3s;
        }

        .cw-progress-caption small {
            font-size: 0.7rem;
            font-weight: 400;
            display: block;
            margin-top: 2px;
        }

        .cw-progress-point.cw-progress-point--active .cw-progress-caption,
        .cw-progress-point.cw-progress-point--done .cw-progress-caption {
            color: #000000;
        }

        .email-card {
            margin-top: 20px;
            padding: 20px;
            background: #fff6f7;
            border: 1px solid #ffd7dc;
            border-radius: 14px;
        }

        .email-card h2 {
            margin: 0 0 8px;
            font-size: 1.05rem;
            color: #b42330;
        }

        .email-card p {
            margin: 0 0 14px;
            font-size: 0.9rem;
            line-height: 1.5;
            color: #4b4b4b;
        }

        .email-form {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .email-input {
            flex: 1 1 220px;
            min-width: 0;
            padding: 12px 14px;
            border: 1px solid #d7c3c7;
            border-radius: 10px;
            font-size: 0.95rem;
        }

        .email-input:focus {
            outline: none;
            border-color: #000000;
            box-shadow: 0 0 0 3px rgba(230, 57, 70, 0.12);
        }

        .email-button {
            border: 0;
            border-radius: 10px;
            padding: 12px 18px;
            background: #000000;
            color: #fff;
            font-size: 0.95rem;
            font-weight: 600;
            cursor: pointer;
        }

        .email-note {
            margin-top: 10px;
            font-size: 0.82rem;
            color: #6b6b6b;
        }

        @media (max-width: 560px) {

            .cw-progress-rail {
                left: calc(8px + 22px);
                right: calc(8px + 22px);
            }

            .cw-progress-points.cw-progress-points--single {
                justify-content: flex-end;
            }
        }
    </style>


  
  <div class="cw-progress-shell">
        <div class="cw-progress-card">
            <p class="cw-progress-text" id="cwProgressMessage">
                Spend <strong>Rs. 2,000</strong> to unlock <strong>Free Gift product</strong>.
            </p>

            <div class="cw-progress-rail-wrap">
                <div class="cw-progress-rail">
                    <div class="cw-progress-rail-fill" id="cwProgressFill"></div>
                </div>

                <div class="cw-progress-points" id="cwProgressPoints"></div>
            </div>
        </div>
    </div>
