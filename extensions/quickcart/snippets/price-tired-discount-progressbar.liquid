  <style>
    .page-shell-upcartapp_progoressbar-wrapper  {
      max-width: 520px;
      font-family: "Helvetica Neue", Arial, sans-serif;
      margin: 0 auto;
    }


    .milestone-progress {
      background: transparent;
      padding: 8px 12px 9px;
     
    }

    .milestone-progress__message {
      font-size: 13px;
      color: #333;
      text-align: center;
      margin: 0 0 5px;
      line-height: 1.5;
    }

    .milestone-progress__message strong {
      color: #000000;
    }

    .milestone-progress__track-wrap {
      position: relative;
      padding: 0 16px;
    }

    .milestone-progress__track {
      position: absolute;
      top: 15px;
      left: calc(16px + 22px);
      right: calc(16px + 22px);
      height: 5px;
      background: #e0e0e0;
      border-radius: 10px;
      overflow: hidden;
      z-index: 0;
    }

    .milestone-progress__fill {
      height: 100%;
      width: 0%;
      background: linear-gradient(to right, #000000, #020101);
      border-radius: 10px;
      transition: width 0.6s cubic-bezier(.4, 0, .2, 1);
    }

    .milestone-progress__steps {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      position: relative;
      z-index: 1;
    }

    .milestone-progress__steps.is-single {
          justify-content: flex-end;
          width: 135px;
          margin-left: auto;
    }

    .milestone-progress__step {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      flex: 1;
    }

    .milestone-progress__icon {
      width: 30px;
      height: 30px;
      border-radius: 50%;
      background: #f0f0f0;
      border: 2.5px solid #d0d0d0;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.4s, border-color 0.4s, box-shadow 0.4s;
      position: relative;
    }

    .milestone-progress__icon svg {
      width: 20px;
      height: 20px;
      color: #999;
      transition: color 0.4s;
    }

    .milestone-progress__step.is-active .milestone-progress__icon {
      background: #fff;
      border-color: #000000;
      /* box-shadow: 0 0 0 4px rgba(230, 57, 70, 0.12); */
    }

    .milestone-progress__step.is-active .milestone-progress__icon svg {
      color: #000000;
    }

      .milestone-progress__step.is-complete .milestone-progress__icon {
        background: linear-gradient(135deg, #000000, #000000);
        border-color: #000000;
        box-shadow: 0 4px 14px rgb(0 0 0 / 30%);
    }

    .milestone-progress__step.is-complete .milestone-progress__icon svg {
      color: #fff;
      display: none;
    }

    .milestone-progress__step.is-complete .milestone-progress__icon::after {
      content: "\2713";
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 17px;
      color: #fff;
      font-weight: 700;
    }

    .milestone-progress__label {
         font-size: 13px;
        font-weight: 600;
        text-align: center;
        line-height: 1.3;
        transition: color 0.3s;
    }
      #milestoneProgressFill{display: block;}
  .milestone-progress__label small {
      font-family: 'Montserrat';
      font-size: 12px;
      font-weight: 400;
      display: block;
      margin-top: 2px;

    } 

    .milestone-progress__step.is-active .milestone-progress__label,
    .milestone-progress__step.is-complete .milestone-progress__label {
      color: #000000;
    }

    .email-card {
      margin-top: 20px;
      padding: 20px;
      background: #fff6f7;
      border: 1px solid #ffd7dc;
      border-radius: 14px;
    }

    .email-card h2 {
      margin: 0 0 8px;
      font-size: 1.05rem;
      color: #b42330;
    }

    .email-card p {
      margin: 0 0 14px;
      font-size: 0.9rem;
      line-height: 1.5;
      color: #4b4b4b;
    }

    .email-form {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    .email-input {
      flex: 1 1 220px;
      min-width: 0;
      padding: 12px 14px;
      border: 1px solid #d7c3c7;
      border-radius: 10px;
      font-size: 0.95rem;
    }

    .email-input:focus {
      outline: none;
      border-color: #000000;
      box-shadow: 0 0 0 3px rgba(230, 57, 70, 0.12);
    }

    .email-button {
      border: 0;
      border-radius: 10px;
      padding: 12px 18px;
      background: #000000;
      color: #fff;
      font-size: 0.95rem;
      font-weight: 600;
      cursor: pointer;
    }

    .email-note {
      margin-top: 10px;
      font-size: 0.82rem;
      color: #6b6b6b;
    }

    @media (max-width: 560px) {
      .milestone-progress {
        padding: 1px 12px 10px;
      }
      .milestone-progress__step{gap:6px;}
      .milestone-progress__steps{gap:2px;}

      .milestone-progress__track-wrap {
        padding: 0 8px;
      }

      .milestone-progress__track {
        left: calc(8px + 22px);
        right: calc(8px + 22px);
      }

      .milestone-progress__steps.is-single {
        justify-content: flex-end;
      }
    }
  </style>
 

<div class="page-shell-upcartapp_progoressbar-wrapper " style="display:none;">
    <div class="milestone-progress">
      <p class="milestone-progress__message" id="milestoneProgressMessage">
        Spend <strong>{{ shop.currency }} 2,000</strong> to unlock <strong>Free Gift product</strong>.
      </p>

      <div class="milestone-progress__track-wrap">
        <div class="milestone-progress__track">
          <div class="milestone-progress__fill" id="milestoneProgressFill"></div>
        </div>

        <div class="milestone-progress__steps" id="milestoneProgressSteps"></div>
      </div>
    </div>
  </div>

